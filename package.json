{
  "name": "ujto-landing",
  "private": true,
  "version": "2.0.0",
  "description": "Ujtö̀ landing (ujto.jcampos.dev): content-driven marketing site",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm check:i18n && tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs && node scripts/find-hardcoded-text.mjs"
  },
  "dependencies": {
    "@pacific-code-labs/ujto-ds": "github:Pacific-Code-Labs/ujto-design-system#v0.5.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "tailwindcss": "^4.1.0",
    "typescript": "5.6.3",
    "vite": "^6.3.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  }
}
