# Frontend build-time configuration (Vite). Normally generated into .env.local by
#   bash scripts/load-env-from-ssm.sh prod
# from SSM /video-transcript/<env>/web. Copy this file to .env.local only if you
# have no AWS access. Only public values belong here; they ship to the browser.

# Backend API (Pacific-Code-Labs/video-transcript-be)
VITE_API_BASE_URL=http://localhost:8000

# Cognito (public identifiers, not secrets)
VITE_AWS_REGION=us-east-1
VITE_AWS_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_AWS_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe publishable key (payments are not enabled yet)
VITE_STRIPE_PUBLIC_KEY=
